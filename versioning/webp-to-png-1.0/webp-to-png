#!/bin/bash
#wtp (webp-to-png)
#
# Version 1.0

TARGET_DIR="${1:-.}"

if [[ ! -d "$TARGET_DIR" ]]; then
    echo "Error: '$TARGET_DIR' is not a valid directory."
    exit 1
fi

# This is for my sanity
cd "$TARGET_DIR" || exit
mkdir -p converted_pngs

for file in *.webp; do
    [ -e "$file" ] || { echo "No .webp files found in $(pwd)"; exit; }

    filename="${file%.*}"

    # -n skip if the file already exists
    # -loglevel error keeps the terminal clean
    ffmpeg -i "$file" -n -loglevel error "converted_pngs/${filename}.png"

    echo "Converted: $file"
done

echo "Done, check $TARGET_DIR."
