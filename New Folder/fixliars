#!/bin/bash
# fixliar - Rename Liars script
# Renames files pretending to be JPEG when they're actually WebP.
# Version 1.2
# Usage: fixliar [directory]

TARGET="${1:-.}"

if [[ ! -d "$TARGET" ]]; then
    echo "Error: '$TARGET' is not a valid directory." >&2
    exit 1
fi

CHECKED=0
RENAMED=0

while IFS= read -r -d '' file; do
    ((CHECKED++))
    if file "$file" | grep -q "Web/P"; then
        newname="${file%.jpg}.webp"
        mv "$file" "$newname"
        ((RENAMED++))
    fi
    printf "\rScanning... checked %d / renamed %d" "$CHECKED" "$RENAMED"
done < <(find "$TARGET" -name "*.jpg" -print0)

printf "\nDone. %d files checked, %d renamed.\n" "$CHECKED" "$RENAMED"
