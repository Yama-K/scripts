#!/bin/bash
# webp-to-png (wtp)
# Converts WebP images to PNG, with optional traversal, subfolder output, and deletion.
# Version 2.0
# Usage: webp-to-png [options] [directory]
#   -n, --new       Output to 'converted_pngs' subfolder
#   -d, --delete    Delete original WebP after successful conversion
#   -nd / -dn       Both of the above

USE_SUBFOLDER=false
DELETE_ORIGINAL=false
TARGET="."

# Parse combined short flags and long flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        --new)    USE_SUBFOLDER=true ;;
        --delete) DELETE_ORIGINAL=true ;;
        -*)
            # Handle combined short flags e.g. -nd -dn -n -d
            flags="${1#-}"
            for (( i=0; i<${#flags}; i++ )); do
                case "${flags:$i:1}" in
                    n) USE_SUBFOLDER=true ;;
                    d) DELETE_ORIGINAL=true ;;
                    *) echo "Unknown flag: -${flags:$i:1}" >&2; exit 1 ;;
                esac
            done
            ;;
        *) TARGET="$1" ;;
    esac
    shift
done

if [[ ! -d "$TARGET" ]]; then
    echo "Error: '$TARGET' is not a valid directory." >&2
    exit 1
fi

CHECKED=0
CONVERTED=0
FAILED=0

while IFS= read -r -d '' file; do
    ((CHECKED++))

    if $USE_SUBFOLDER; then
        # Mirror directory structure under converted_pngs
        rel="${file#$TARGET/}"
        outdir="$TARGET/converted_pngs/$(dirname "$rel")"
        mkdir -p "$outdir"
        outfile="$outdir/$(basename "${file%.webp}.png")"
    else
        outfile="${file%.webp}.png"
    fi

    if ffmpeg -i "$file" -n -loglevel error "$outfile"; then
        ((CONVERTED++))
        if $DELETE_ORIGINAL; then
            rm "$file"
        fi
    else
        ((FAILED++))
    fi

    printf "\rScanning... checked %d / converted %d / failed %d" "$CHECKED" "$CONVERTED" "$FAILED"

done < <(find "$TARGET" -name "*.webp" -print0)

printf "\nDone. %d checked, %d converted, %d failed.\n" "$CHECKED" "$CONVERTED" "$FAILED"
