#!/bin/bash

echo -ne "\033]0;Simple Convert\007"

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 <files> <target_format>"
    exit 1
fi

format="${@: -1}"

for input in "${@:1:$#-1}"; do

    # Handle the case where someone literally types "*" in quotes
    if [[ "$input" == "*" ]]; then
        for file in *; do
            [[ -f "$file" && "$file" != "$0" ]] || continue
            filename="${file%.*}"
            ffmpeg -i "$file" "${filename}.${format}"
        done
    elif [[ -f "$input" ]]; then
        # Handle individual files (including those expanded by the shell)
        filename="${input%.*}"
        ffmpeg -i "$input" "${filename}.${format}"
    fi
done
